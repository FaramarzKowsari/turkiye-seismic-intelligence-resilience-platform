@echo off
setlocal EnableExtensions DisableDelayedExpansion
chcp 65001 >nul
title Apply Zenodo DOI 10.5281/zenodo.21797833
set "TMPPY=%TEMP%\apply_zenodo_doi_21797833_%RANDOM%_%RANDOM%.py"
set "TMPB64=%TEMP%\apply_zenodo_doi_21797833_%RANDOM%_%RANDOM%.b64"
if exist "%TMPPY%" del /q "%TMPPY%" >nul 2>&1
if exist "%TMPB64%" del /q "%TMPB64%" >nul 2>&1
>>"%TMPB64%" echo 
>>"%TMPB64%" echo 
>>"%TMPB64%" echo 
>>"%TMPB64%" echo 
>>"%TMPB64%" echo 
>>"%TMPB64%" echo 
>>"%TMPB64%" echo 
>>"%TMPB64%" echo 
>>"%TMPB64%" echo 
>>"%TMPB64%" echo 
>>"%TMPB64%" echo 
>>"%TMPB64%" echo 
>>"%TMPB64%" echo 
>>"%TMPB64%" echo 
>>"%TMPB64%" echo 
>>"%TMPB64%" echo 
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$s=[IO.File]::ReadAllText('%TMPB64%').Replace([Environment]::NewLine,'');[IO.File]::WriteAllBytes('%TMPPY%',[Convert]::FromBase64String($s))"
if errorlevel 1 goto :decode_error

where py >nul 2>&1
if not errorlevel 1 (
  py -3 "%TMPPY%" "%~dp0"
) else (
  where python >nul 2>&1
  if errorlevel 1 goto :python_missing
  python "%TMPPY%" "%~dp0"
)

set "RESULT=%ERRORLEVEL%"
del /q "%TMPPY%" >nul 2>&1
del /q "%TMPB64%" >nul 2>&1
echo.
if "%RESULT%"=="0" (
  echo SUCCESS: DOI updates were applied and validated.
) else (
  echo ERROR: The updater reported a problem.
)
echo.
pause
exit /b %RESULT%

:python_missing
echo.
echo ERROR: Python was not found.
echo Install Python 3 or run this file from the project environment.
del /q "%TMPPY%" >nul 2>&1
del /q "%TMPB64%" >nul 2>&1
pause
exit /b 1

:decode_error
echo.
echo ERROR: The temporary Python updater could not be created.
del /q "%TMPPY%" >nul 2>&1
del /q "%TMPB64%" >nul 2>&1
pause
exit /b 1
