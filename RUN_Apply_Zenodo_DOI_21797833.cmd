@echo off
setlocal EnableExtensions DisableDelayedExpansion
chcp 65001 >nul
title Apply Zenodo DOI 10.5281/zenodo.21797833
set "TMPB64=%TEMP%\apply_doi_21797833_%RANDOM%_%RANDOM%.b64"
set "TMPPS1=%TEMP%\apply_doi_21797833_%RANDOM%_%RANDOM%.ps1"
if exist "%TMPB64%" del /q "%TMPB64%" >nul 2>&1
if exist "%TMPPS1%" del /q "%TMPPS1%" >nul 2>&1
>>"%TMPB64%" echo 
>>"%TMPB64%" echo 
>>"%TMPB64%" echo 
>>"%TMPB64%" echo 
>>"%TMPB64%" echo 
>>"%TMPB64%" echo 
>>"%TMPB64%" echo 
>>"%TMPB64%" echo 
>>"%TMPB64%" echo 
>>"%TMPB64%" echo 
>>"%TMPB64%" echo 
>>"%TMPB64%" echo 
>>"%TMPB64%" echo 
>>"%TMPB64%" echo 
>>"%TMPB64%" echo 
>>"%TMPB64%" echo 
>>"%TMPB64%" echo 
>>"%TMPB64%" echo 
>>"%TMPB64%" echo 
>>"%TMPB64%" echo 
>>"%TMPB64%" echo 
>>"%TMPB64%" echo 
>>"%TMPB64%" echo 
>>"%TMPB64%" echo 
>>"%TMPB64%" echo 
>>"%TMPB64%" echo 
>>"%TMPB64%" echo 
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$b=[IO.File]::ReadAllText('%TMPB64%').Replace([Environment]::NewLine,'');[IO.File]::WriteAllBytes('%TMPPS1%',[Convert]::FromBase64String($b))"
if errorlevel 1 goto :decode_error
powershell.exe -NoProfile -ExecutionPolicy Bypass -File "%TMPPS1%" -RepoPath "%~dp0"
set "RESULT=%ERRORLEVEL%"
del /q "%TMPB64%" >nul 2>&1
del /q "%TMPPS1%" >nul 2>&1
echo.
if "%RESULT%"=="0" (
  echo SUCCESS: DOI updates were applied and validated.
) else (
  echo ERROR: The update did not complete successfully.
)
echo.
pause
exit /b %RESULT%

:decode_error
echo ERROR: Could not create the temporary PowerShell script.
del /q "%TMPB64%" >nul 2>&1
del /q "%TMPPS1%" >nul 2>&1
pause
exit /b 1
